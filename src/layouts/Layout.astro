---
import '../styles/app.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Shyamika AI | Custom Website Developer for Local Business", 
  description = "Shyamika AI is a top custom website developer agency. We provide affordable web design, website redesign services, and AI website design for US local businesses." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Shyamika Ai" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph & SEO -->
    <meta property="og:site_name" content="Shyamika AI" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://shyamikaai.com/" />
    <meta property="og:image" content="/services-pc.webp" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    
    <!-- Google Fonts: Inter, JetBrains Mono, and Newsreader -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;400;500;600;700&family=JetBrains+Mono:wght@400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet">
    
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-JDWQK97TF8"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-JDWQK97TF8');
    </script>
  </head>
  <body class="bg-canvas text-ink selection:bg-cyan/30 selection:text-white">
    <slot />
    <script is:inline>
      // Gradient button hover animation — driven by JS to guarantee smooth CSS property transitions.
      // CSS :hover on @property custom properties breaks under Tailwind v4's @layer cascade ordering.

      const HOVER_STATES = {
        default: {
          '--pos-x': '0%',
          '--pos-y': '91.51%',
          '--spread-x': '120.24%',
          '--spread-y': '103.18%',
          '--color-1': '#c96287',
          '--color-2': '#c66c64',
          '--color-3': '#cc7d23',
          '--color-4': '#37140a',
          '--color-5': '#000',
          '--border-angle': '190deg',
          '--border-color-1': 'hsla(340, 78%, 90%, 0.1)',
          '--border-color-2': 'hsla(340, 75%, 90%, 0.6)',
          '--stop-1': '0%',
          '--stop-2': '8.8%',
          '--stop-3': '21.44%',
          '--stop-4': '71.34%',
          '--stop-5': '85.76%',
        },
        variant: {
          '--pos-x': '0%',
          '--pos-y': '95.51%',
          '--spread-x': '110.24%',
          '--spread-y': '110.2%',
          '--color-1': '#000020',
          '--color-2': '#f1ffa5',
          '--color-3': '#469396',
          '--color-4': '#1f3f6d',
          '--color-5': '#000',
          '--border-angle': '210deg',
          '--border-color-1': 'hsla(320, 75%, 90%, 0.2)',
          '--border-color-2': 'hsla(320, 50%, 90%, 0.75)',
          '--stop-1': '0%',
          '--stop-2': '10%',
          '--stop-3': '35.44%',
          '--stop-4': '71.34%',
          '--stop-5': '90.76%',
        },
      };

      const REST_STATES = {
        default: {
          '--pos-x': '11.14%',
          '--pos-y': '140%',
          '--spread-x': '150%',
          '--spread-y': '180.06%',
          '--color-1': '#000',
          '--color-2': '#08012c',
          '--color-3': '#4e1e40',
          '--color-4': '#70464e',
          '--color-5': '#88394c',
          '--border-angle': '20deg',
          '--border-color-1': 'hsla(340, 75%, 60%, 0.2)',
          '--border-color-2': 'hsla(340, 75%, 40%, 0.75)',
          '--stop-1': '37.35%',
          '--stop-2': '61.36%',
          '--stop-3': '78.42%',
          '--stop-4': '89.52%',
          '--stop-5': '100%',
        },
        variant: {
          '--pos-x': '11.14%',
          '--pos-y': '140%',
          '--spread-x': '150%',
          '--spread-y': '180.06%',
          '--color-1': '#000022',
          '--color-2': '#1f3f6d',
          '--color-3': '#469396',
          '--color-4': '#f1ffa5',
          '--color-5': '#000',
          '--border-angle': '200deg',
          '--border-color-1': 'hsla(320, 75%, 90%, 0.6)',
          '--border-color-2': 'hsla(320, 50%, 90%, 0.15)',
          '--stop-1': '37.35%',
          '--stop-2': '61.36%',
          '--stop-3': '78.42%',
          '--stop-4': '89.52%',
          '--stop-5': '100%',
        },
      };

      function applyState(el, state) {
        for (const [prop, val] of Object.entries(state)) {
          el.style.setProperty(prop, val);
        }
      }

      function initGradientButtons() {
        document.querySelectorAll('.gradient-button').forEach((el) => {
          const isVariant = el.classList.contains('gradient-button-variant');
          const type = isVariant ? 'variant' : 'default';

          // Set rest state explicitly so the browser has a start point to interpolate from
          applyState(el, REST_STATES[type]);

          el.addEventListener('mouseenter', () => applyState(el, HOVER_STATES[type]));
          el.addEventListener('mouseleave', () => applyState(el, REST_STATES[type]));
        });
      }

      // Run on first load
      initGradientButtons();

      // Re-run after Astro view transitions (if any)
      document.addEventListener('astro:page-load', initGradientButtons);
    </script>
    <script is:inline>
      function initSlideUpCards() {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('translate-y-32');
              entry.target.classList.add('translate-y-0');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15,
          rootMargin: "0px 0px -50px 0px"
        });

        document.querySelectorAll('.slide-up-card').forEach(el => {
          observer.observe(el);
        });
      }

      // Run on first load
      initSlideUpCards();

      // Re-run after Astro view transitions (if any)
      document.addEventListener('astro:page-load', initSlideUpCards);
    </script>
  </body>
</html>
