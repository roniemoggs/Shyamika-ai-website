---
---

<section class="py-24 md:py-32 bg-canvas relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-10 relative z-10">
    <div class="flex flex-col md:flex-row gap-12 items-center">
      
      <!-- Text Content -->
      <div class="flex-1 space-y-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-hairline bg-canvas-soft/50 backdrop-blur-md">
          <span class="text-xs font-mono text-mute tracking-wider uppercase">Old Websites vs Modern Websites</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl font-sans font-extralight tracking-[-0.02em] leading-tight text-[#F5F5DC] text-balance">
          Same brand, <br class="hidden md:block"/>better website.
        </h2>
        
        <p class="text-lg text-body max-w-xl text-pretty">
          Slow, outdated websites drive customers away. Our custom websites load instantly and are easy to use. Whether you need a new site or a redesign, our modern approach helps you get 3.5x more customers.
        </p>
        
        <div class="flex items-center gap-4 mt-4">
          <div class="flex flex-col gap-1">
            <span class="text-4xl font-sans font-semibold text-white">99+</span>
            <span class="text-xs font-mono text-mute uppercase tracking-widest">Speed Score</span>
          </div>
          <div class="w-px h-12 bg-hairline"></div>
          <div class="flex flex-col gap-1">
            <span class="text-4xl font-sans font-semibold text-white">3.5x</span>
            <span class="text-xs font-mono text-mute uppercase tracking-widest">More Sales</span>
          </div>
        </div>
      </div>
      
      <!-- Visual Compare Cards -->
      <div class="flex-1 w-full max-w-lg relative slide-up-card translate-y-32 transition-all duration-1000 ease-out">
        <!-- Legacy Web Card (Background) -->
        <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-xl border border-hairline bg-canvas-soft opacity-50 p-6 flex flex-col gap-4 filter blur-[1px]">
          <div class="flex items-center gap-3 mb-2">
            <div class="w-2 h-2 rounded-full bg-red-500"></div>
            <span class="text-sm font-mono text-mute">Old Template Site</span>
          </div>
          <div class="h-2 w-3/4 bg-hairline rounded"></div>
          <div class="h-2 w-full bg-hairline rounded"></div>
          <div class="h-2 w-5/6 bg-hairline rounded"></div>
          <div class="mt-4 flex items-center justify-between text-xs font-mono text-red-500/80">
            <span>Wait Time: 4.8s</span>
            <span>People Leaving: 68%</span>
          </div>
        </div>

        <!-- Shyamika Modern Platform Card (Foreground) -->
        <div class="relative z-10 glass-card rounded-xl p-8 flex flex-col gap-6 transform hover:-translate-y-1 transition-transform duration-500">
          <div class="flex items-center gap-3 border-b border-hairline pb-4">
            <span class="relative flex h-3 w-3">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-blue-500 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-3 w-3 bg-blue-500"></span>
            </span>
            <span class="text-sm font-mono text-white">Our Modern Platform</span>
          </div>
          
          <div class="space-y-4">
            <div class="flex justify-between items-center bg-canvas p-3 rounded border border-hairline">
              <span class="text-xs font-mono text-mute">Page Load Speed</span>
              <span class="text-xs font-mono text-blue-400">Instant</span>
            </div>
            <div class="flex justify-between items-center bg-canvas p-3 rounded border border-hairline">
              <span class="text-xs font-mono text-mute">Google Health Score</span>
              <span class="text-xs font-mono text-blue-400">Perfect Score</span>
            </div>
            <div class="flex justify-between items-center bg-canvas p-3 rounded border border-hairline">
              <span class="text-xs font-mono text-mute">Smart Features</span>
              <span class="text-xs font-mono text-blue-400">Built-in</span>
            </div>
          </div>
        </div>
        
        <!-- Decorative Glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-blue-500/20 blur-[100px] rounded-full pointer-events-none z-0"></div>
      </div>
      
    </div>
  </div>
</section>
