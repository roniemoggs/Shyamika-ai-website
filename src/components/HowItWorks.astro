---
const steps = [
  {
    title: "Planning & Design",
    desc: "We study your customers, create a beautiful design, and choose the best tools to make your website fast and reliable.",
  },
  {
    title: "Building the Website",
    desc: "We build your website using the latest technology, adding smooth animations and smart AI features.",
  },
  {
    title: "Testing & Launch",
    desc: "We test your site for speed, make sure it shows up on Google, and support you even after it goes live.",
  },
];
---

<section
  id="how-it-works"
  class="py-24 md:py-32 relative bg-cover bg-center bg-no-repeat"
  style="background-image: linear-gradient(to bottom, #0a0a0a 0%, transparent 15%, transparent 85%, #0a0a0a 100%), url('/process-main.webp?v=2');"
>
  <div class="max-w-7xl mx-auto px-6 md:px-10 relative z-10">
    <div class="text-left mb-16 md:mb-24 max-w-3xl">
      <h2
        class="text-3xl md:text-5xl font-sans font-extralight tracking-[-0.02em] text-white"
      >
        From idea to a fast website <br class="hidden sm:block" />in
        weeks, not months.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-8 relative">
      <!-- Connecting Line -->
      <div
        class="hidden md:block absolute top-[40px] left-[40px] right-[40px] h-px bg-gradient-to-r from-transparent via-hairline to-transparent z-0"
      >
      </div>

      {
        steps.map((step, idx) => (
          <div class="relative z-10 flex flex-col items-start text-left">
            <div class="w-20 h-20 rounded-full bg-canvas border border-hairline flex items-center justify-center mb-8 relative">
              <div class="absolute inset-2 rounded-full bg-canvas-soft flex items-center justify-center font-mono text-lg text-white">
                0{idx + 1}
              </div>
            </div>
            <h3 class="text-xl font-sans font-semibold text-white mb-4">
              {step.title}
            </h3>
            <p class="text-body max-w-sm">{step.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
