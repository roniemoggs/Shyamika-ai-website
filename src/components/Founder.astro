---
---

<section id="about" class="pt-36 pb-28 md:pt-64 md:pb-48 bg-canvas relative overflow-hidden">
  <!-- Background Image with mask blending -->
  <picture class="absolute inset-x-0 top-0 w-full pointer-events-none select-none z-0 flex justify-center items-start" style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 70%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 70%, transparent 100%);">
    <source media="(min-width: 768px)" srcset="/about-bg.webp" />
    <img src="/about-mobile.webp" alt="" class="w-auto h-auto max-w-full md:w-full md:h-full md:object-cover opacity-80" />
  </picture>

  <div class="max-w-4xl mx-auto px-6 md:px-10 relative z-10">
    
    <div class="relative rounded-[36px] overflow-hidden p-8 md:p-14 border border-white/10 bg-white/5 backdrop-blur-md shadow-2xl">

      <div class="relative z-10 grid md:grid-cols-12 gap-10 md:gap-12 items-center">
        
        <!-- Left Column: Content -->
        <div class="md:col-span-7 flex flex-col justify-between space-y-10">
          <div>
            <!-- Headline -->
            <h2 class="text-4xl md:text-5xl font-sans text-white tracking-tight mb-8 font-extralight">
              Founder
            </h2>
            
            <!-- Description -->
            <p class="text-slate-200/90 font-sans text-sm md:text-base leading-relaxed max-w-xl">
              At Shyamika AI, led by technical expertise and a vision for accessible AI and high-impact web engineering, we bring a focused approach to software architecture, web platforms, and machine learning.
            </p>
          </div>

          <!-- Founder Info Badge -->
          <div class="flex items-center gap-4 pt-4">
            <div class="w-14 h-14 rounded-full overflow-hidden border-2 border-white/20 shadow-md flex-shrink-0 bg-canvas-soft">
              <img 
                src="/rohan-singh.png" 
                alt="Rohan Singh Avatar" 
                class="w-full h-full object-cover"
              />
            </div>
            <div class="flex flex-col">
              <span class="font-sans text-xl text-white font-medium tracking-tight">Rohan Singh</span>
              <span class="font-sans text-xs text-cyan tracking-[0.2em] uppercase font-semibold">FOUNDER & CEO</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Founder Portrait Photo -->
        <div class="md:col-span-5 relative">
          <div class="relative rounded-[28px] overflow-hidden border border-white/15 shadow-2xl bg-canvas-soft group">
            <img 
              src="/rohan-singh.png" 
              alt="Rohan Singh - Founder & CEO" 
              class="w-full h-[280px] md:h-[320px] object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
            />
            <!-- Subtle gradient vignette at bottom -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
