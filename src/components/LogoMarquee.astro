---
const logos = [
  "Godrej", "Tata", "Reliance", "Mahindra", "Infosys", "Wipro", "HDFC Bank", "Zomato"
];
---

<section class="border-y border-hairline bg-canvas pt-4 pb-5 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 md:px-10 mb-3 text-center">
    <p class="font-mono text-xs tracking-[0.2em] uppercase text-mute">Trusted by Industry Leaders</p>
  </div>
  
  <div class="relative flex overflow-x-hidden group">
    <div class="animate-marquee whitespace-nowrap flex items-center gap-16 px-8">
      {logos.map(logo => (
        <span class="font-sans font-semibold text-2xl text-hairline hover:text-white transition-colors cursor-default">
          {logo}
        </span>
      ))}
      {/* Duplicate for seamless looping */}
      {logos.map(logo => (
        <span class="font-sans font-semibold text-2xl text-hairline hover:text-white transition-colors cursor-default">
          {logo}
        </span>
      ))}
    </div>
    <div class="absolute top-0 animate-marquee2 whitespace-nowrap flex items-center gap-16 px-8">
      {logos.map(logo => (
        <span class="font-sans font-semibold text-2xl text-hairline hover:text-white transition-colors cursor-default">
          {logo}
        </span>
      ))}
      {logos.map(logo => (
        <span class="font-sans font-semibold text-2xl text-hairline hover:text-white transition-colors cursor-default">
          {logo}
        </span>
      ))}
    </div>
    
    <!-- Fade edges -->
    <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-canvas to-transparent pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-canvas to-transparent pointer-events-none"></div>
  </div>
</section>

<style>
  @keyframes marquee {
    0% { transform: translateX(0%); }
    100% { transform: translateX(-100%); }
  }
  @keyframes marquee2 {
    0% { transform: translateX(100%); }
    100% { transform: translateX(0%); }
  }
  .animate-marquee {
    animation: marquee 30s linear infinite;
  }
  .animate-marquee2 {
    animation: marquee2 30s linear infinite;
  }
  .group:hover .animate-marquee,
  .group:hover .animate-marquee2 {
    animation-play-state: paused;
  }
</style>
