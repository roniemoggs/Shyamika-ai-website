---

---

<section
  id="contact"
  class="pt-48 pb-8 md:pt-72 md:pb-12 relative overflow-hidden border-t border-hairline bg-canvas"
>
  <!-- Background Image with mask blending -->
  <picture class="absolute inset-x-0 top-0 w-full pointer-events-none select-none z-0" style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 75%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 75%, transparent 100%);">
    <source media="(min-width: 768px)" srcset="/contact-bg.webp" />
    <img src="/contact-mobile.webp" alt="Abstract Contact Background" class="w-full h-auto" />
  </picture>

  <div class="max-w-7xl mx-auto px-6 md:px-10 relative z-10">

    <div class="max-w-2xl mx-auto glass-card rounded-2xl p-8 md:p-12">
      <h3 class="text-3xl font-sans font-extralight tracking-[-0.02em] text-white mb-8 text-center">Get In Touch</h3>
      <div class="space-y-8">
        <p class="text-lg font-sans font-thin text-white/90 text-center leading-relaxed">
          Book a quick 15-minute intro call to discuss your web design, tech stack, or project scope.
        </p>

        <div class="space-y-6">
          <h4 class="text-sm font-mono text-white uppercase tracking-wide border-b border-hairline pb-2">What to Expect on the Call</h4>
          
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="text-cyan mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Project Scope & Tech Stack:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">We'll dive into your vision, functional requirements, design preferences, and ideal tech stack (e.g., React, Next.js, Webflow, WordPress).</span>
              </div>
            </li>
            <li class="flex items-start">
              <span class="text-cyan mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Timeline & Budget Estimate:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">Get a clear idea of realistic project turnaround, milestones, and flexible pricing options.</span>
              </div>
            </li>
            <li class="flex items-start">
              <span class="text-cyan mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Actionable Roadmap:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">Leave the call with clear next steps for your site, whether you decide to work with us or not. No hard pitches.</span>
              </div>
            </li>
          </ul>
        </div>

        <button
          class="w-full bg-white text-canvas-soft hover:bg-gray-100 font-sans font-extralight py-4 rounded-lg transition-colors duration-300 flex items-center justify-center gap-2"
        >
          Book a 15-Min Strategy Call
        </button>
      </div>
    </div>
  </div>
</section>

