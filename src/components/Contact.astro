---
import { GradientButton } from '@/components/ui/gradient-button';

const CALENDLY_URL = "https://calendly.com/rohansingh-shyamikai/simple-meeting";
---

<section
  id="contact"
  class="pt-48 pb-8 md:pt-72 md:pb-12 relative overflow-hidden border-t border-hairline bg-canvas"
>
  <!-- Background Image with mask blending -->
  <picture class="absolute inset-x-0 top-0 w-full pointer-events-none select-none z-0 flex justify-center items-start" style="-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 70%, transparent 100%); mask-image: linear-gradient(to bottom, transparent 0%, black 10%, black 70%, transparent 100%);">
    <source media="(min-width: 768px)" srcset="/contact-bg.webp" />
    <img src="/contact-mobile.webp" alt="Abstract Contact Background" class="w-auto h-auto max-w-full md:w-full md:h-auto" />
  </picture>

  <div class="max-w-7xl mx-auto px-6 md:px-10 relative z-10">

    <div class="max-w-2xl mx-auto glass-card rounded-2xl p-8 md:p-12 slide-up-card translate-y-32 transition-all duration-1000 ease-out">
      <h3 class="text-3xl font-sans font-extralight tracking-[-0.02em] text-white mb-8 text-center">Get In Touch</h3>
      <div class="space-y-8">
        <p class="text-lg font-sans font-thin text-white/90 text-center leading-relaxed">
          Book a quick 15-minute intro call to discuss your website needs and project goals.
        </p>

        <div class="space-y-6">
          <h4 class="text-sm font-mono text-white uppercase tracking-wide border-b border-hairline pb-2">What to Expect on the Call</h4>
          
          <ul class="space-y-4">
            <li class="flex items-start">
              <span class="text-sky-400 mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Your Goals & Needs:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">We'll talk about what you want your website to do, how you want it to look, and what features will help your business the most.</span>
              </div>
            </li>
            <li class="flex items-start">
              <span class="text-sky-400 mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Time & Cost:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">Get a clear idea of how long the project will take and straightforward pricing options that fit your budget.</span>
              </div>
            </li>
            <li class="flex items-start">
              <span class="text-sky-400 mr-3 mt-1">•</span>
              <div>
                <strong class="text-white font-sans font-extralight">Clear Next Steps:</strong>
                <span class="text-white/90 font-sans font-thin leading-relaxed block mt-1">Leave the call with a clear plan for your website, even if you decide not to work with us. No pressure or sales tricks.</span>
              </div>
            </li>
          </ul>
        </div>

        <GradientButton 
          variant="variant" 
          href={CALENDLY_URL}
          target="_blank"
          rel="noopener noreferrer"
          className="inline-flex h-12 md:h-14 px-6 rounded-full font-semibold hover:scale-105 transition-transform w-full items-center justify-center text-base md:text-lg"
        >
          Book a Strategy Call
        </GradientButton>
      </div>
    </div>
  </div>
</section>

