---
import ChromaticFluid from "./ui/chromatic-fluid";
const CALENDLY_URL = "https://calendly.com/rohansingh-shyamikai/simple-meeting";
import { GradientButton } from '@/components/ui/gradient-button';
---

<section class="relative w-full" id="hero">
<ChromaticFluid client:load height="100vh" className="relative flex flex-col justify-center overflow-hidden min-h-[100vh]" bottomFade={true}>
  <div class="relative max-w-7xl mx-auto px-6 md:px-16 w-full flex flex-col justify-center min-h-[100vh] pt-24 pb-6">

    <!-- Main grid: Headline left, Right column top-aligned -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-12 lg:gap-16 items-end">

      <!-- LEFT: Big headline -->
      <div class="relative">
        <h1 class="text-4xl sm:text-6xl md:text-7xl font-sans font-semibold tracking-[-0.04em] leading-[1.05] text-white mix-blend-difference text-balance">
          Custom Website<br/>Developer for<br/>US Local<br/>Businesses.
        </h1>
        <!-- blend layer -->
        <h1 class="absolute top-0 left-0 w-full h-full text-4xl sm:text-6xl md:text-7xl font-sans font-semibold tracking-[-0.04em] leading-[1.05] text-white mix-blend-color text-balance pointer-events-none" aria-hidden="true">
          Custom Website<br/>Developer for<br/>US Local<br/>Businesses.
        </h1>
      </div>

      <!-- RIGHT: Subtext + CTAs -->
      <div class="flex flex-col gap-7 lg:pb-2">
        <p class="text-base md:text-lg text-body leading-relaxed opacity-80">
          <strong class="text-white font-medium">Shyamika AI</strong> helps local businesses in the US turn website visitors into paying customers with fast, easy-to-use websites.
        </p>

        <div class="flex flex-col gap-3">
          <GradientButton 
            variant="variant" 
            href={CALENDLY_URL}
            target="_blank"
            rel="noopener noreferrer"
            className="w-full rounded-full font-semibold text-base px-8 py-3 hover:scale-105 transition-transform flex items-center justify-center gap-2"
          >
            Book A Call
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </GradientButton>
          <a 
            href="#how-it-works"
            class="w-full px-8 py-3 rounded-full bg-white/5 border border-white/10 text-white/80 font-semibold text-base hover:bg-white/10 hover:text-white transition-all flex items-center justify-center"
          >
            See how it works
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom trust bar -->
    <div class="mt-7 pt-4 border-t border-white/10 flex items-center gap-6 text-xs font-mono text-mute uppercase tracking-widest opacity-40">
      <span>100+ Web Builds</span>
      <span class="w-1 h-1 rounded-full bg-mute"></span>
      <span>Always Online & Fast</span>
    </div>

  </div>
</ChromaticFluid>
</section>
