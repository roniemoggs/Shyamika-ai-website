---
const links = [
  { name: 'Home', href: '/' },
  { name: 'Case Studies', href: '/#case-studies' },
  { name: 'Services', href: '/#services' },
  { name: 'About', href: '/about' },
  { name: 'Process', href: '/#how-it-works' },
  { name: 'Contact', href: '/contact' },
];

const CALENDLY_URL = "https://calendly.com/rohansingh-shyamikai/simple-meeting";
import { GradientButton } from '@/components/ui/gradient-button';
---

<header id="navbar" class="!fixed top-0 left-1/2 -translate-x-1/2 z-50 w-full transition-all duration-500 bg-canvas/70 backdrop-blur-xl border-b border-hairline">
  <div id="navbar-inner" class="max-w-7xl mx-auto px-6 md:px-10 h-16 flex items-center justify-between transition-all duration-500">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <img src="/ShyamikaAi-logo.png" alt="Shyamika AI" class="w-8 h-8 object-contain" />
      <span class="font-sans font-semibold text-xl tracking-tight text-white group-hover:text-cyan transition-colors">
        Shyamika AI
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {links.map((link) => (
        <a 
          href={link.href} 
          data-section={link.href.includes('#') ? link.href.split('#')[1] : ''}
          class="nav-link relative py-1 text-sm font-medium text-body hover:text-white transition-colors"
        >
          {link.name}
        </a>
      ))}
    </nav>

    <!-- CTAs -->
    <div class="flex items-center gap-4">
      <GradientButton 
        variant="variant" 
        href={CALENDLY_URL}
        target="_blank"
        rel="noopener noreferrer"
        className="hidden sm:inline-flex h-9 px-5 rounded-full text-sm font-semibold hover:scale-105 transition-transform"
      >
        Book A Call
      </GradientButton>
      
      <!-- Mobile Menu Button -->
      <button id="mobile-menu-btn" class="md:hidden text-white p-2" aria-label="Toggle menu">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

</header>

<!-- Mobile Menu Drawer Overlay -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden"></div>

<!-- Mobile Menu Drawer -->
<div id="mobile-menu" class="fixed top-0 right-0 w-[280px] h-[100dvh] bg-canvas/70 backdrop-blur-2xl border-l border-hairline z-50 transform translate-x-full transition-transform duration-300 md:hidden flex flex-col shadow-2xl">
  <div class="px-6 h-16 flex items-center justify-between border-b border-hairline">
    <a href="/" class="flex items-center gap-2 group">
      <img src="/ShyamikaAi-logo.png" alt="Shyamika AI" class="w-8 h-8 object-contain" />
      <span class="font-sans font-semibold text-xl tracking-tight text-white group-hover:text-cyan transition-colors">
        Shyamika AI
      </span>
    </a>
    <button id="mobile-menu-close" class="text-white p-2" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>
  <div class="flex-1 overflow-y-auto px-6 py-8">
    <nav class="flex flex-col gap-6">
      {links.map((link) => (
        <a 
          href={link.href} 
          class="mobile-nav-link text-xl font-medium text-body hover:text-white transition-colors"
        >
          {link.name}
        </a>
      ))}
    </nav>
    <div class="mt-8">
      <GradientButton 
        variant="variant" 
        href={CALENDLY_URL}
        target="_blank"
        rel="noopener noreferrer"
        className="inline-flex h-11 px-6 rounded-full font-semibold hover:scale-105 transition-transform w-full"
      >
        Book A Call
      </GradientButton>
    </div>
  </div>
</div>

<script>
  function handleScroll() {
    const navbar = document.getElementById('navbar');
    const inner = document.getElementById('navbar-inner');
    
    if (window.scrollY > 50) {
      // Scrolled state: Floating Pill
      navbar.classList.remove('top-0', 'w-full', 'border-b', 'bg-canvas/70', 'border-hairline');
      navbar.classList.add('top-4', 'w-[calc(100%-2rem)]', 'max-w-5xl', 'rounded-full', 'glass-card', 'shadow-[0_8px_32px_-8px_rgba(0,0,0,0.5)]');
      
      inner.classList.remove('px-6', 'md:px-10');
      inner.classList.add('px-4', 'md:px-6');
    } else {
      // Top state: Full Width
      navbar.classList.add('top-0', 'w-full', 'border-b', 'bg-canvas/70', 'border-hairline');
      navbar.classList.remove('top-4', 'w-[calc(100%-2rem)]', 'max-w-5xl', 'rounded-full', 'glass-card', 'shadow-[0_8px_32px_-8px_rgba(0,0,0,0.5)]');
      
      inner.classList.add('px-6', 'md:px-10');
      inner.classList.remove('px-4', 'md:px-6');
    }
  }

  // Initial check in case of page reload half-way scrolled
  handleScroll();
  window.addEventListener('scroll', handleScroll);

  // Mobile Menu Toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenuCloseBtn = document.getElementById('mobile-menu-close');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');
  const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');

  function openMobileMenu() {
    mobileMenu?.classList.remove('translate-x-full');
    mobileMenuOverlay?.classList.remove('opacity-0', 'pointer-events-none');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileMenu() {
    mobileMenu?.classList.add('translate-x-full');
    mobileMenuOverlay?.classList.add('opacity-0', 'pointer-events-none');
    document.body.style.overflow = '';
  }

  mobileMenuBtn?.addEventListener('click', openMobileMenu);
  mobileMenuCloseBtn?.addEventListener('click', closeMobileMenu);
  mobileMenuOverlay?.addEventListener('click', closeMobileMenu);

  // Close mobile menu when a link is clicked
  mobileNavLinks.forEach(link => {
    link.addEventListener('click', closeMobileMenu);
  });

  // Active section observer
  const navLinks = document.querySelectorAll('.nav-link');
  const sections = Array.from(navLinks).map(link => {
    const sectionId = link.getAttribute('data-section');
    return document.getElementById(sectionId);
  }).filter(Boolean);

  const observerOptions = {
    root: null,
    rootMargin: '-30% 0px -70% 0px', // Trigger when section hits upper part of viewport
    threshold: 0
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const id = entry.target.id;
        navLinks.forEach(link => {
          if (link.getAttribute('data-section') === id) {
            link.classList.add('active');
          } else {
            link.classList.remove('active');
          }
        });
      }
    });
  }, observerOptions);

  sections.forEach(section => observer.observe(section));
</script>

<style>
  .nav-link.active {
    color: white;
  }
  
  .nav-link.active::after {
    content: '';
    position: absolute;
    bottom: -6px; /* Positioned slightly below text */
    left: 50%;
    transform: translateX(-50%);
    width: 80%; /* Wider width */
    height: 12px; /* Larger height for more volume to blur */
    background-color: white; /* Light base */
    border-radius: 50%; /* Oval shape */
    filter: blur(8px); /* Heavy blur for soft diffuse glow */
    opacity: 0.85; /* Increased opacity for a brighter glow */
    z-index: -1; /* Place behind text */
  }
</style>
