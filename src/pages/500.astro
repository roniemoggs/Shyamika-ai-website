---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  error?: unknown;
}

const { error } = Astro.props;
---

<Layout title="Internal Server Error | Shyamika AI" description="An unexpected error occurred on the server.">
  <Navbar />
  
  <main class="pt-40 pb-20 min-h-[70vh] flex flex-col items-center justify-center text-center px-6">
    <div class="max-w-2xl mx-auto">
      <div class="inline-block mb-4 px-3 py-1 rounded-full border border-white/10 bg-white/5 backdrop-blur-sm">
        <span class="text-xs font-medium text-white/70 uppercase tracking-widest">Error 500</span>
      </div>
      <h1 class="text-6xl md:text-8xl font-bold text-white mb-6 tracking-tight">Server Error</h1>
      <p class="text-body text-lg mb-10 max-w-md mx-auto leading-relaxed text-white/60">
        Oops! Something went wrong on our end. Please try again later or contact us if the issue persists.
      </p>
      <a href="/" class="inline-flex items-center justify-center px-8 py-4 text-sm font-medium text-black bg-white rounded-full hover:bg-gray-200 transition-all duration-300">
        Return Home
      </a>
    </div>
  </main>

  <Footer />
</Layout>
