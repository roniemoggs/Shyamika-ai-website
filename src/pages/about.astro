---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Founder from "../components/Founder.astro";
---

<Layout title="About Us | Shyamika AI" description="Learn more about Shyamika AI and our mission.">
  <Navbar />
  
  <main class="pt-32 pb-10">
    <div class="max-w-4xl mx-auto px-6 md:px-10 font-sans text-center mb-10">
      <h1 class="text-4xl md:text-5xl font-semibold text-white mb-6">About Shyamika AI</h1>
      <p class="text-body text-lg leading-relaxed max-w-2xl mx-auto">
        We are a top-rated custom website agency focused on building fast, beautiful, and reliable websites. Our mission is to help local businesses and larger companies grow by giving them a powerful online presence.
      </p>
    </div>
    
    <!-- Use existing Founder component for visual impact -->
    <Founder />
  </main>

  <Footer />
</Layout>
